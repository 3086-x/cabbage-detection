# ==========================================================
# 甘蓝检测复现项目 — 忽略规则
#
# 设计原则：仓库只保留「代码 + 配置 + 结果报告」。
#           数据、权重、训练产物、毕业材料一律本地保留。
# 为什么不公开数据见 DATA.md。
# ==========================================================

# ---------- Python 环境 ----------
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/

# ---------- 训练产物与权重 ----------
# runs/ 约 1.8G，含 33 个 run 的 best.pt / last.pt / 训练曲线
runs/
*.pt
*.pth
*.onnx
*.engine
*.torchscript
logs/
*.log

# ---------- 数据集（自采，不随仓库分发）----------
# 仅说明格式与划分，原始影像/标注/原始点标注均不发布
dataset/
images/
labels/
ground_truth/
weights/

# ---------- 毕业设计材料（含个人信息）----------
# 论文 / 答辩 PPT / 演示视频 / 开题与中期报告
project/
*.pptx
*.docx
*.pdf
*.mp4

# ---------- 早期实现（与 tools/ 重复，且写死绝对路径）----------
# 保留在本地备查，不纳入仓库；仓库内的权威实现是 tools/
Code/
/*.py
/*.txt
!/requirements.txt
/*.ipynb

# 根目录早期模型配置（已被 cfg/ 下的版本取代）
/yolo11n_cbam.yaml
/yolo11n_se.yaml

